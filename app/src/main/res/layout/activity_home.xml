<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_background"
    android:fitsSystemWindows="true"
    tools:context="com.tianma.xsmscode.ui.home.HomeActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/m3_background"
        app:elevation="0dp">

        <!-- Google Messages Standard Top App Bar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/m3_background"
            app:navigationIcon="@mipmap/ic_launcher"
            app:title="@string/app_name"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
            app:titleTextColor="@color/m3_on_surface" />

        <!-- Material 3 Expressive Hero Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_module_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="4dp"
            app:cardBackgroundColor="@color/m3_card_background"
            app:cardCornerRadius="@dimen/m3_card_corner_radius"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="9dp"
                android:paddingEnd="16dp"
                android:paddingBottom="9dp">

                <!-- Status Icon Badge -->
                <ImageView
                    android:id="@+id/iv_status_badge"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_m3_badge_green"
                    android:padding="6dp"
                    android:src="@drawable/ic_done" />

                <TextView
                    android:id="@+id/tv_status_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="API 102 · 已激活"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="@color/m3_on_surface"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content (SettingsFragment) -->
    <FrameLayout
        android:id="@+id/home_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- Google Messages Style Extended FAB for Quick SMS Parsing Test -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_test_sms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:text="测试解析"
        android:textColor="@color/m3_on_primary"
        app:backgroundTint="@color/m3_primary"
        app:cornerRadius="28dp"
        app:elevation="4dp"
        app:icon="@drawable/ic_copy"
        app:iconTint="@color/m3_on_primary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>